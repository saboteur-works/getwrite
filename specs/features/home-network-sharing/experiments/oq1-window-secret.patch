+++ b/frontend/proxy.ts
@@ -0,0 +1,29 @@
+import { appendFileSync } from "node:fs";
+import { NextResponse } from "next/server";
+import type { NextRequest } from "next/server";
+
+/**
+ * SPIKE (OQ-1, throwaway): logs which request kinds carry the window secret
+ * as a header and as a cookie. Booleans only; the secret is never logged.
+ */
+export function proxy(request: NextRequest): NextResponse {
+  const secret = process.env.GETWRITE_SPIKE_SECRET ?? "";
+  const header = request.headers.get("x-getwrite-spike");
+  const cookie = request.cookies.get("getwrite_spike")?.value;
+  const line = {
+    pathname: request.nextUrl.pathname,
+    method: request.method,
+    "sec-fetch-dest": request.headers.get("sec-fetch-dest"),
+    "sec-fetch-mode": request.headers.get("sec-fetch-mode"),
+    headerPresent: header !== null,
+    headerMatches: secret !== "" && header === secret,
+    cookiePresent: cookie !== undefined,
+    cookieMatches: secret !== "" && cookie === secret,
+    "x-forwarded-for": request.headers.get("x-forwarded-for"),
+  };
+  const logPath = process.env.SPIKE_LOG;
+  if (logPath) {
+    appendFileSync(logPath, `${JSON.stringify(line)}\n`);
+  }
+  return NextResponse.next();
+}
